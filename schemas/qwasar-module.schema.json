{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SilverCrow2323/Void-Desk-Project/blob/main/schemas/qwasar-module.schema.json",
  "title": "QWASAR Module Manifest",
  "description": "Strict signed module package contract. Contributions reference registered QWASAR UI components and slots; privileged operations are declared capabilities, never embedded shell commands.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "name",
    "version",
    "kind",
    "publisher",
    "license",
    "compatibility",
    "contributions",
    "actions",
    "capabilities",
    "permissions",
    "dependencies",
    "desktopPackages",
    "files",
    "artifact",
    "signature"
  ],
  "properties": {
    "manifestVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "enum": [
        "declarative",
        "executable"
      ]
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]{2,64}$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumVoidDeskVersion",
        "minimumUiApi",
        "engines",
        "platforms"
      ],
      "properties": {
        "minimumVoidDeskVersion": {
          "type": "string",
          "maxLength": 32
        },
        "maximumVoidDeskVersion": {
          "type": "string",
          "maxLength": 32
        },
        "minimumUiApi": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pygame",
              "love",
              "qt6",
              "lvgl",
              "web"
            ]
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "muos",
              "knulli",
              "rocknix",
              "desktop",
              "custom",
              "any"
            ]
          }
        },
        "deviceFamilies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "architectures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "aarch64",
              "armv7",
              "x86_64",
              "x86",
              "any"
            ]
          }
        }
      }
    },
    "contributions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/contribution"
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId",
          "versionConstraint"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"
          },
          "versionConstraint": {
            "type": "string",
            "maxLength": 64
          },
          "optional": {
            "type": "boolean"
          }
        }
      }
    },
    "desktopPackages": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "required",
          "purpose"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.-]{0,127}$"
          },
          "versionConstraint": {
            "type": "string",
            "maxLength": 64
          },
          "architectures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "arm64",
                "armhf",
                "amd64",
                "all"
              ]
            }
          },
          "required": {
            "type": "boolean"
          },
          "purpose": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    },
    "settingsSchema": {
      "type": "object",
      "description": "JSON Schema for non-secret module settings; paths/credentials must be excluded."
    },
    "entrypoints": {
      "$ref": "#/$defs/entrypoints"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "signature": {
      "$ref": "#/$defs/signature"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceRepository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sourceCommit": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{40}$"
        },
        "buildWorkflow": {
          "type": "string",
          "maxLength": 160
        },
        "builtAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slot",
        "componentType",
        "label",
        "capabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "slot": {
          "enum": [
            "nexus.node",
            "workspace.section",
            "hub.panel",
            "menu.tile",
            "menu.entry",
            "dashboard.widget",
            "shell.header",
            "shell.footer",
            "home.left",
            "home.right",
            "overlay.media",
            "session.target",
            "desktop.launcher"
          ]
        },
        "componentType": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+){1,3}$"
        },
        "workspaceId": {
          "$ref": "#/$defs/id"
        },
        "sectionId": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]{1,160}$"
        },
        "props": {
          "type": "object",
          "maxProperties": 64
        },
        "actionIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "providerId": {
          "$ref": "#/$defs/id"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "fallback": {
          "type": "string",
          "maxLength": 160
        },
        "orderHint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "route",
            "host-capability",
            "module-handler"
          ]
        },
        "routeId": {
          "$ref": "#/$defs/id"
        },
        "capability": {
          "$ref": "#/$defs/id"
        },
        "handlerId": {
          "$ref": "#/$defs/id"
        },
        "permission": {
          "$ref": "#/$defs/id"
        },
        "argumentsSchema": {
          "type": "object"
        },
        "confirmation": {
          "enum": [
            "none",
            "host-required",
            "host-typed"
          ]
        },
        "dangerous": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "route"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "routeId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "host-capability"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "capability"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "module-handler"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "handlerId",
              "capability",
              "permission"
            ]
          }
        }
      ]
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "pygame": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]{1,160}$"
        },
        "love": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]{1,160}$"
        },
        "qt6": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]{1,160}$"
        },
        "lvgl": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]{1,160}$"
        },
        "web": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_./-]{1,160}$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9._/-]{1,240}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "executable"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "entrypoints"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "declarative"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "not": {
                "properties": {
                  "kind": {
                    "const": "module-handler"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
