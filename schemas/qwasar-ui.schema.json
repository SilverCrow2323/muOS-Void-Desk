{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SilverCrow2323/Void-Desk-Project/blob/main/schemas/qwasar-ui.schema.json",
  "title": "QWASAR UI Composition Manifest",
  "description": "Engine-neutral declarative UI composition contract. It defines components, layouts and registered action references; it never carries executable callbacks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "apiVersion",
    "engineAdapters",
    "componentRegistry",
    "shell",
    "workspaces",
    "actions",
    "keymap"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "engineAdapters": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/engineAdapter"
      }
    },
    "componentRegistry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/componentDefinition"
      }
    },
    "shell": {
      "$ref": "#/$defs/shell"
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/workspace"
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/actionDefinition"
      }
    },
    "keymap": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/keyBinding"
      }
    },
    "legacyAliases": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "oldId",
          "newId"
        ],
        "properties": {
          "oldId": {
            "$ref": "#/$defs/id"
          },
          "newId": {
            "$ref": "#/$defs/id"
          },
          "section": {
            "$ref": "#/$defs/id"
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
    },
    "engineAdapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "uiApi"
      ],
      "properties": {
        "id": {
          "enum": [
            "pygame",
            "love",
            "qt6",
            "lvgl",
            "web"
          ]
        },
        "status": {
          "enum": [
            "current",
            "planned"
          ]
        },
        "uiApi": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "componentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "stateModel",
        "slots",
        "customizable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+){1,3}$"
        },
        "kind": {
          "enum": [
            "layout",
            "surface",
            "display",
            "widget",
            "menu",
            "navigation",
            "input",
            "overlay",
            "feedback"
          ]
        },
        "stateModel": {
          "enum": [
            "stateless",
            "stateful"
          ]
        },
        "slots": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "customizable": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "minUiApi": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "fallback": {
          "type": "string",
          "maxLength": 96
        }
      }
    },
    "componentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+){1,3}$"
        },
        "props": {
          "type": "object",
          "maxProperties": 64
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/componentNode"
          }
        },
        "slots": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/$defs/componentNode"
            }
          }
        },
        "actionId": {
          "$ref": "#/$defs/id"
        },
        "fallback": {
          "type": "string",
          "maxLength": 96
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "content"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "placement": {
          "enum": [
            "leading",
            "trailing",
            "left",
            "right",
            "top",
            "bottom",
            "overlay",
            "docked"
          ]
        },
        "collapsible": {
          "type": "boolean"
        },
        "content": {
          "$ref": "#/$defs/componentNode"
        },
        "collapsedByDefault": {
          "type": "boolean"
        },
        "minWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "preferredWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "footer",
        "homePanels",
        "globalPanels"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/componentNode"
        },
        "footer": {
          "$ref": "#/$defs/componentNode"
        },
        "homePanels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right"
          ],
          "properties": {
            "left": {
              "$ref": "#/$defs/region"
            },
            "right": {
              "$ref": "#/$defs/region"
            }
          }
        },
        "globalPanels": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "#/$defs/globalPanel"
          }
        },
        "statusDock": {
          "$ref": "#/$defs/componentNode"
        }
      }
    },
    "globalPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "placement",
        "content",
        "triggerAction"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "placement": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "center",
            "fullscreen"
          ]
        },
        "content": {
          "$ref": "#/$defs/componentNode"
        },
        "triggerAction": {
          "$ref": "#/$defs/id"
        },
        "modal": {
          "type": "boolean"
        },
        "dismissIntent": {
          "type": "string",
          "maxLength": 48
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "template",
        "layout",
        "menu"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "nodeId": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "template": {
          "enum": [
            "session-selector",
            "package-workbench",
            "network-console",
            "media-library",
            "tool-workbench",
            "settings-workbench",
            "reference-library",
            "system-exit",
            "custom"
          ]
        },
        "status": {
          "enum": [
            "current",
            "planned",
            "migration-target"
          ]
        },
        "layout": {
          "$ref": "#/$defs/componentNode"
        },
        "widgets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/componentNode"
          }
        },
        "sections": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "menu": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/menuEntry"
          }
        },
        "legacyRoutes": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "layout": {
          "$ref": "#/$defs/componentNode"
        },
        "widgets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/componentNode"
          }
        },
        "menu": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/menuEntry"
          }
        }
      }
    },
    "menuEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "route",
            "command",
            "submenu",
            "toggle",
            "value",
            "dynamic",
            "external",
            "separator"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "icon": {
          "type": "string",
          "maxLength": 96
        },
        "actionId": {
          "$ref": "#/$defs/id"
        },
        "children": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/menuEntry"
          }
        },
        "providerId": {
          "$ref": "#/$defs/id"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "dangerous": {
          "type": "boolean"
        },
        "confirmation": {
          "enum": [
            "none",
            "host-required",
            "host-typed"
          ]
        },
        "unavailableMessage": {
          "type": "string",
          "maxLength": 160
        },
        "valueSource": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "actionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "route",
            "command",
            "toggle",
            "overlay",
            "system"
          ]
        },
        "target": {
          "type": "string",
          "maxLength": 128
        },
        "capability": {
          "$ref": "#/$defs/id"
        },
        "permission": {
          "type": "string",
          "maxLength": 96
        },
        "confirmation": {
          "enum": [
            "none",
            "host-required",
            "host-typed"
          ]
        },
        "dangerous": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "implemented",
            "planned",
            "migration-alias"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 240
        }
      }
    },
    "keyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actionId",
        "input",
        "value"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "actionId": {
          "$ref": "#/$defs/id"
        },
        "input": {
          "enum": [
            "keyboard",
            "gamepad-intent",
            "touch",
            "mouse"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "default": {
          "type": "boolean"
        }
      }
    }
  }
}
