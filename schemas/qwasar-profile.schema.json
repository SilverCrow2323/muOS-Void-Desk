{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SilverCrow2323/Void-Desk-Project/blob/main/schemas/qwasar-profile.schema.json",
  "title": "QWASAR Portable UI Profile",
  "description": "Portable data-only UI arrangement and feature-state overrides. It cannot install modules, define routes/actions, grant permissions, select local install paths or embed executable code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "compatibility",
    "workspaceOrder",
    "shell",
    "workspaceOverrides",
    "theme"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "author": {
      "type": "string",
      "maxLength": 80
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumUiApi",
        "platforms"
      ],
      "properties": {
        "minimumUiApi": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "muos",
              "knulli",
              "rocknix",
              "desktop",
              "custom",
              "any"
            ]
          }
        },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "workspaceOrder": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "shell": {
      "$ref": "#/$defs/shell"
    },
    "workspaceOverrides": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/workspaceOverride"
      }
    },
    "moduleStates": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "moduleId",
          "enabled"
        ],
        "properties": {
          "moduleId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "contributionStates": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/contributionState"
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionId",
          "input",
          "value"
        ],
        "properties": {
          "actionId": {
            "$ref": "#/$defs/id"
          },
          "input": {
            "enum": [
              "keyboard",
              "gamepad-intent",
              "touch",
              "mouse"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visualStyle": {
          "enum": [
            "megastructure",
            "manga_ink",
            "industrial",
            "terminal",
            "neon_noir",
            "minimal"
          ]
        },
        "palette": {
          "enum": [
            "crimson",
            "cyberpunk",
            "green",
            "stealth",
            "amber",
            "ice",
            "paper",
            "signal_red"
          ]
        },
        "density": {
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ]
        },
        "motion": {
          "enum": [
            "full",
            "reduced",
            "off"
          ]
        }
      }
    },
    "settings": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^(?!.*(?:[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_ -]?[Kk][Ee][Yy]|[Aa][Pp][Ii][_ -]?[Kk][Ee][Yy]|[Ii][Nn][Ss][Tt][Aa][Ll][Ll][_ -]?[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee][Ss][Yy][Ss][Tt][Ee][Mm][_ -]?[Pp][Aa][Tt][Hh])).+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/safeSettingValue"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"
    },
    "regionOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "collapsedByDefault": {
          "type": "boolean"
        },
        "placement": {
          "enum": [
            "leading",
            "trailing",
            "left",
            "right",
            "top",
            "bottom",
            "overlay",
            "docked"
          ]
        },
        "density": {
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ]
        },
        "slotOrder": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contributionOrder": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "hiddenContributions": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "footer",
        "homePanels",
        "globalPanels"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/regionOverride"
        },
        "footer": {
          "$ref": "#/$defs/regionOverride"
        },
        "homePanels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right"
          ],
          "properties": {
            "left": {
              "$ref": "#/$defs/regionOverride"
            },
            "right": {
              "$ref": "#/$defs/regionOverride"
            }
          }
        },
        "globalPanels": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "#/$defs/regionOverride"
          }
        }
      }
    },
    "contributionState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contributionId",
        "state"
      ],
      "properties": {
        "contributionId": {
          "$ref": "#/$defs/id"
        },
        "state": {
          "enum": [
            "enabled",
            "disabled",
            "hidden"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "labelOverride": {
          "type": "string",
          "maxLength": 64
        },
        "iconOverride": {
          "type": "string",
          "maxLength": 96
        }
      }
    },
    "sectionOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "labelOverride": {
          "type": "string",
          "maxLength": 64
        },
        "menuOrder": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "hiddenMenuEntries": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "contributions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/contributionState"
          }
        }
      }
    },
    "workspaceOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "enabled": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "labelOverride": {
          "type": "string",
          "maxLength": 64
        },
        "iconOverride": {
          "type": "string",
          "maxLength": 96
        },
        "menuOrder": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "hiddenMenuEntries": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "sections": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/sectionOverride"
          }
        },
        "contributions": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/contributionState"
          }
        }
      }
    },
    "safeSettingValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/safeSettingValue"
          }
        },
        {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "pattern": "^(?!.*(?:[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_ -]?[Kk][Ee][Yy]|[Aa][Pp][Ii][_ -]?[Kk][Ee][Yy]|[Ii][Nn][Ss][Tt][Aa][Ll][Ll][_ -]?[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee][Ss][Yy][Ss][Tt][Ee][Mm][_ -]?[Pp][Aa][Tt][Hh])).+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/safeSettingValue"
          }
        }
      ]
    }
  }
}
