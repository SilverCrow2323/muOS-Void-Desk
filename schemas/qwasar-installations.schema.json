{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SilverCrow2323/Void-Desk-Project/blob/main/schemas/qwasar-installations.schema.json",
  "title": "QWASAR Installed Runtime Instances",
  "description": "Host-local inventory written by trusted installers and the launch selector. It is not a profile or community-download format. File paths and executable entrypoints are intentionally not supplied by imported profiles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "instances"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "instances": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/instance"
      }
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "productId",
        "flavour",
        "version",
        "packageId",
        "installAdapter",
        "platforms",
        "engines",
        "defaultEngine",
        "status",
        "dataNamespace"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
        },
        "productId": {
          "const": "void-desk"
        },
        "displayName": {
          "type": "string",
          "maxLength": 80
        },
        "flavour": {
          "enum": [
            "full",
            "essential",
            "slim",
            "custom"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "packageId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]{1,95}$"
        },
        "installAdapter": {
          "enum": [
            "muos-muxapp",
            "debian-package",
            "desktop-portable",
            "developer-checkout"
          ]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "muos",
              "knulli",
              "rocknix",
              "desktop-linux",
              "custom"
            ]
          }
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "pygame",
              "love",
              "qt6",
              "lvgl",
              "web"
            ]
          }
        },
        "defaultEngine": {
          "enum": [
            "pygame",
            "love",
            "qt6",
            "lvgl",
            "web"
          ]
        },
        "status": {
          "enum": [
            "installed",
            "disabled",
            "broken",
            "incompatible",
            "needs-migration"
          ]
        },
        "dataNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "activeProfileId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "updateChannel": {
          "enum": [
            "stable",
            "beta",
            "nightly",
            "local"
          ]
        },
        "installedAt": {
          "type": "string",
          "format": "date-time"
        },
        "engineVersions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "engine",
              "version",
              "status"
            ],
            "properties": {
              "engine": {
                "enum": [
                  "pygame",
                  "love",
                  "qt6",
                  "lvgl",
                  "web"
                ]
              },
              "version": {
                "type": "string",
                "maxLength": 32
              },
              "status": {
                "enum": [
                  "ready",
                  "missing",
                  "incompatible",
                  "broken"
                ]
              }
            }
          }
        }
      }
    }
  }
}
