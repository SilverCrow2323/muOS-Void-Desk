{
  "schemaVersion": "1.0",
  "id": "qwasar.ui.void-desk.default",
  "apiVersion": "1.0",
  "description": "Reference QWASAR interface composition for Void Desk. This is a target manifest; entries marked planned or migration-target are not yet active runtime contributions.",
  "engineAdapters": [
    {
      "id": "pygame",
      "status": "current",
      "uiApi": "1.0",
      "notes": "Reference Void Desk frontend; native renderer."
    },
    {
      "id": "love",
      "status": "current",
      "uiApi": "1.0",
      "notes": "Alternative Void Desk frontend; composition migration remains incomplete."
    },
    {
      "id": "qt6",
      "status": "planned",
      "uiApi": "1.0",
      "notes": "Future desktop-native adapter."
    },
    {
      "id": "lvgl",
      "status": "planned",
      "uiApi": "1.0",
      "notes": "Future embedded/low-resource adapter."
    },
    {
      "id": "web",
      "status": "planned",
      "uiApi": "1.0",
      "notes": "Future QWASAR Studio preview/renderer adapter; not an installed handheld runtime."
    }
  ],
