  "shell": {
    "header": {
      "id": "shell.header",
      "type": "layout.row",
      "props": {
        "region": "header",
        "heightToken": "shell.header.height",
        "density": "comfortable"
      },
      "slots": {
        "leading": [
          {
            "id": "header.brand",
            "type": "display.icon",
            "props": {
              "iconId": "qwasar.voiddesk-mark",
              "size": "brand"
            }
          }
        ],
        "context": [
          {
            "id": "header.context",
            "type": "display.text",
            "props": {
              "localizationKey": "shell.context.title",
              "textStyle": "context-title"
            }
          }
        ],
        "status": [
          {
            "id": "header.status",
            "type": "layout.row",
            "props": {
              "gapToken": "space.2"
            },
            "children": [
              {
                "id": "header.network",
                "type": "widget.status-card",
                "props": {
                  "provider": "system.network.summary",
                  "compact": true
                }
              },
              {
                "id": "header.battery",
                "type": "widget.stat",
                "props": {
                  "provider": "system.battery",
                  "unit": "%"
                }
              }
            ]
          }
        ],
        "trailing": [
          {
            "id": "header.profile",
            "type": "display.badge",
            "props": {
              "provider": "profile.active",
              "fallback": "DEFAULT"
            }
          }
        ]
      }
    },
    "footer": {
      "id": "shell.footer",
      "type": "layout.row",
      "props": {
        "region": "footer",
        "heightToken": "shell.footer.height",
        "density": "compact"
      },
      "slots": {
        "navigation": [
          {
            "id": "footer.navigation-hints",
            "type": "widget.item-list",
            "props": {
              "provider": "navigation.context-hints",
              "maxItems": 4
            }
          }
        ],
        "status": [
          {
            "id": "footer.runtime-status",
            "type": "display.text",
            "props": {
              "provider": "runtime.status.short"
            }
          }
        ]
      }
    },
    "homePanels": {
      "left": {
        "enabled": true,
        "placement": "left",
        "collapsible": true,
        "collapsedByDefault": false,
        "preferredWidth": 112,
        "content": {
          "id": "home.left-panel",
          "type": "surface.panel",
          "slots": {
            "body": [
              {
                "id": "home.favourites",
                "type": "widget.item-list",
                "props": {
                  "provider": "profile.favourites",
                  "maxItems": 5
                }
              }
            ]
          }
        }
      },
      "right": {
        "enabled": true,
        "placement": "right",
        "collapsible": true,
        "collapsedByDefault": true,
        "preferredWidth": 124,
        "content": {
          "id": "home.right-panel",
          "type": "surface.panel",
          "slots": {
            "body": [
              {
                "id": "home.telemetry",
                "type": "layout.stack",
                "children": [
                  {
                    "id": "home.network-summary",
                    "type": "widget.status-card",
                    "props": {
                      "provider": "system.network.summary"
                    }
                  },
                  {
                    "id": "home.storage-summary",
                    "type": "widget.stat",
                    "props": {
                      "provider": "system.storage.primary"
                    }
                  },
                  {
                    "id": "home.jobs-summary",
                    "type": "widget.status-card",
                    "props": {
                      "provider": "jobs.summary"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    "globalPanels": {
      "mediaPlayer": {
        "enabled": true,
        "placement": "bottom",
        "modal": false,
        "triggerAction": "panel.media.toggle",
        "dismissIntent": "overlay.dismiss",
        "content": {
          "id": "panel.media-player",
          "type": "surface.panel",
          "slots": {
            "body": [
              {
                "id": "panel.media-controls",
                "type": "widget.media-player",
                "props": {
                  "provider": "media.active-player",
                  "compact": false,
                  "showSeek": true,
                  "showQueue": false
                }
              }
            ]
          }
        }
      },
      "jobCenter": {
        "enabled": true,
        "placement": "right",
        "modal": false,
        "triggerAction": "panel.jobs.toggle",
        "dismissIntent": "overlay.dismiss",
        "content": {
          "id": "panel.job-center",
          "type": "widget.item-list",
          "props": {
            "provider": "jobs.active-and-recent"
          }
        }
      }
    },
    "statusDock": {
      "id": "shell.status-dock",
      "type": "layout.row",
      "props": {
        "provider": "jobs.foreground-summary",
        "visibleWhen": "jobs.active"
      }
    }
  },
  "workspaces": [
    {
      "id": "start-session",
      "nodeId": 0,
